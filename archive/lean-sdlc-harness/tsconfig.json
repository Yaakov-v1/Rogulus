{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "verbatimModuleSyntax": true,
    "outDir": "dist", "rootDir": "src", "declaration": true, "sourceMap": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
